portstub: link-time stand-ins for the audio/modem providers removed from the port build

diff --git a/drivers/portstub/Kconfig b/drivers/portstub/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/portstub/Kconfig
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0
+config PORT_STUBS
+	bool "Link-time stubs for providers removed from the port build"
+	default y
diff --git a/drivers/portstub/Makefile b/drivers/portstub/Makefile
new file mode 100644
--- /dev/null
+++ b/drivers/portstub/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_PORT_STUBS)	+= portstub.o
diff --git a/drivers/portstub/portstub.c b/drivers/portstub/portstub.c
new file mode 100644
--- /dev/null
+++ b/drivers/portstub/portstub.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * portstub.c - link-time stand-ins for the audio/modem providers that are
+ * compiled out of the clang port build. The stubs keep the kernel linkable;
+ * the corresponding functional blocks are not available in this build.
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+
+long snd_soc_register_component(void) { return 0; }
+EXPORT_SYMBOL(snd_soc_register_component);
+
+long snd_soc_unregister_component(void) { return 0; }
+EXPORT_SYMBOL(snd_soc_unregister_component);
+
+long snd_pcm_format_width(void) { return 16; }
+EXPORT_SYMBOL(snd_pcm_format_width);
+
+long da_combine_wtdog_send_event(void) { return 0; }
+EXPORT_SYMBOL(da_combine_wtdog_send_event);
+
+long da_combine_dsp_dump_with_path(void) { return 0; }
+EXPORT_SYMBOL(da_combine_dsp_dump_with_path);
+
+long get_phy_addr(void) { return 0; }
+EXPORT_SYMBOL(get_phy_addr);
+
+long dsp_watchdog_send_event(void) { return 0; }
+EXPORT_SYMBOL(dsp_watchdog_send_event);
+
+long om_get_dsp_timestamp(void) { return 0; }
+EXPORT_SYMBOL(om_get_dsp_timestamp);
+
+long dsp_reset_release_syscache(void) { return 0; }
+EXPORT_SYMBOL(dsp_reset_release_syscache);
+
+long mailbox_send_msg(void) { return 0; }
+EXPORT_SYMBOL(mailbox_send_msg);
+
+long DRV_MAILBOX_REGISTERRECVFUNC(void) { return 0; }
+EXPORT_SYMBOL(DRV_MAILBOX_REGISTERRECVFUNC);
+
+long DRV_MAILBOX_READMAILDATA(void) { return 0; }
+EXPORT_SYMBOL(DRV_MAILBOX_READMAILDATA);
+
+long mailbox_usb_suspend(void) { return 0; }
+EXPORT_SYMBOL(mailbox_usb_suspend);
+
+long da_combine_resmgr_init(void) { return 0; }
+EXPORT_SYMBOL(da_combine_resmgr_init);
+
+long dsp_msg_init(void) { return 0; }
+EXPORT_SYMBOL(dsp_msg_init);
+
+long socdsp_dump_panic_log(void) { return 0; }
+EXPORT_SYMBOL(socdsp_dump_panic_log);
+
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -12,6 +12,7 @@
 
 
 source "drivers/base/Kconfig"
+source "drivers/portstub/Kconfig"
 
 source "drivers/bus/Kconfig"
 
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -8,6 +8,7 @@
 
 obj-y				+= irqchip/
 obj-y				+= bus/
+obj-$(CONFIG_PORT_STUBS)	+= portstub/
 
 obj-$(CONFIG_GENERIC_PHY)	+= phy/
 
