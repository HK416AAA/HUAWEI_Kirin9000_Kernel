access_tokenid: add a minimal /dev/access_token_id for the HarmonyOS port

diff --git a/drivers/accesstokenid/Kconfig b/drivers/accesstokenid/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/accesstokenid/Kconfig
@@ -0,0 +1,8 @@
+# SPDX-License-Identifier: GPL-2.0
+config ACCESS_TOKENID
+	bool "HarmonyOS access token id device"
+	default y
+	help
+	  Provides /dev/access_token_id, the per-process access token store used by
+	  the HarmonyOS access token kit. Port build: the public tree does not ship
+	  the vendor driver, this is a minimal replacement (token is kept per pid).
