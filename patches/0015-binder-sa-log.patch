binder: log system ability requests to samgr (12 words)

--- a/drivers/android/binder.c
+++ b/drivers/android/binder.c
@@ -4163,10 +4163,24 @@
 #endif
 		return_error = binder_proc_transaction(t, target_proc, NULL);
 		if (return_error)
 			goto err_dead_proc_or_thread;
 	}
+	/* port: log SA requests arriving at samgr (diagnostic) */
+	if (target_proc->tsk && strstr(target_proc->tsk->comm, "samgr") &&
+	    t->buffer && t->buffer->user_data) {
+		u32 w[12] = {0};
+		int i;
+		for (i = 0; i < 12; i++)
+			(void)copy_from_user(&w[i],
+				(u8 __user *)t->buffer->user_data + i * 4, 4);
+		pr_info("port: sa req code=%u n=%zu w=%08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			t->code, t->buffer->data_size,
+			w[0], w[1], w[2], w[3], w[4], w[5],
+			w[6], w[7], w[8], w[9], w[10], w[11]);
+	}
+
 	if (target_thread)
 		binder_thread_dec_tmpref(target_thread);
 	binder_proc_dec_tmpref(target_proc);
 	if (target_node)
 		binder_dec_node_tmpref(target_node);
